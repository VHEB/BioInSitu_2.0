---
interface Member {
  name: string;
  role: string;
  formation: string;
  linkedin?: string | null;
  lattes?: string | null;
  photo?: string | null;
}
interface Props { member: Member }
const { member } = Astro.props;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---

<div class="member">
  <div class="avatar">
    {member.photo ? <img src={member.photo} alt={member.name} /> : <span>{initials}</span>}
  </div>
  <p class="name">{member.name}</p>
  <p class="role">{member.role}</p>
  <p class="formation">{member.formation}</p>
  <div class="links">
    {member.linkedin && (
      <a href={member.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn de ${member.name}`}>LinkedIn</a>
    )}
    {member.lattes && (
      <a href={member.lattes} target="_blank" rel="noopener" aria-label={`Currículo Lattes de ${member.name}`}>Lattes</a>
    )}
  </div>
</div>

<style>
  .member {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 20px;
    text-align: center;
  }
  .avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--green-pale);
    color: var(--green-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    overflow: hidden;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }

  .name { font-weight: 600; font-size: 15.5px; }
  .role { color: var(--coral); font-size: 13px; font-weight: 600; margin-top: 4px; }
  .formation { color: var(--ink-soft); font-size: 13px; margin-top: 6px; line-height: 1.5; }

  .links { display: flex; justify-content: center; gap: 14px; margin-top: 16px; }
  .links a {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--green);
    border-bottom: 1px solid transparent;
  }
  .links a:hover { color: var(--coral); border-color: var(--coral); }
</style>
