---
import Layout from '../../layouts/Layout.astro';

// TODO: troque pelo e-mail real de contato do Bio in Situ.
const CONTACT_EMAIL = 'contato@biologiainsitu.com.br';
---

<Layout title="Contato" description="Fale com o Bio in Situ.">
  <section class="wrap page-head">
    <p class="eyebrow">Fale com a gente</p>
    <h1>Contato</h1>
    <p class="lede">
      Sugestões de pauta, parcerias, dúvidas ou só um oi — escreva pra gente pelo formulário
      abaixo.
    </p>
  </section>

  <section class="wrap form-section">
    <form id="contactForm" class="form">
      <div class="field">
        <label for="name">Nome</label>
        <input id="name" name="name" type="text" required />
      </div>

      <div class="field">
        <label for="email">Seu e-mail</label>
        <input id="email" name="email" type="email" required />
      </div>

      <div class="field">
        <label for="subject">Assunto</label>
        <select id="subject" name="subject">
          <option>Sugestão de pauta</option>
          <option>Parceria</option>
          <option>Imprensa</option>
          <option>Outro</option>
        </select>
      </div>

      <div class="field">
        <label for="message">Mensagem</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Enviar mensagem</button>
      <p id="formNote" class="form-note"></p>
    </form>
  </section>
</Layout>

<style>
  .page-head { padding: 56px 24px 32px; max-width: 640px; }
  .page-head h1 { font-size: clamp(28px, 4vw, 38px); margin-top: 8px; }
  .lede { color: var(--ink-soft); margin-top: 14px; font-size: 15.5px; line-height: 1.6; }

  .form-section { padding: 0 24px 80px; }
  .form { max-width: 560px; display: flex; flex-direction: column; gap: 18px; }

  .field { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 13.5px; font-weight: 600; color: var(--ink); }

  input, select, textarea {
    font-family: var(--font-body);
    font-size: 14.5px;
    padding: 11px 13px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--green);
  }
  textarea { resize: vertical; }

  .form .btn { align-self: flex-start; margin-top: 4px; }

  .form-note {
    font-size: 13px;
    color: var(--ink-soft);
    min-height: 18px;
  }
</style>

<script define:vars={{ CONTACT_EMAIL }}>
  const form = document.getElementById('contactForm');
  const note = document.getElementById('formNote');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name');
    const email = data.get('email');
    const subject = data.get('subject');
    const message = data.get('message');

    const body = `Nome: ${name}\nE-mail: ${email}\n\n${message}`;
    const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
      `[Site] ${subject}`
    )}&body=${encodeURIComponent(body)}`;

    window.location.href = mailto;
    note.textContent = `Se o seu programa de e-mail não abrir automaticamente, escreva direto para ${CONTACT_EMAIL}.`;
  });
</script>
